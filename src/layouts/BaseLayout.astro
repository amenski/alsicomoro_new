---
// Renders the whole <head>, then header / slot / footer plus the shared scripts.
// The head reproduces index.html's order with root-absolute asset paths.
import { site } from '../data/site';
import { paths, ui, type Lang, type PageKey } from '../i18n/ui';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RestaurantSchema from '../components/RestaurantSchema.astro';
import BreadcrumbSchema, { type Crumb } from '../components/BreadcrumbSchema.astro';
import '../styles/main.css';

export interface Alternate {
  hreflang: string;
  href: string;
}

interface Props {
  lang: Lang;
  page: PageKey;
  title: string;
  description: string;
  ogDescription?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  ogImage: string;
  ogImageAlt: string;
  ogType?: string;
  ogImageSize?: { width: number; height: number };
  noindex?: boolean;
  alternates?: Alternate[];
  breadcrumb?: Crumb[];
  schema?: boolean;
  /** Canonical path when it is not the fixed one in `paths` (blog posts). */
  path?: string;
  /** Language toggle target when it is not the fixed one in `toggleTargets`. */
  toggleHref?: string;
}

const {
  lang,
  page,
  title,
  description,
  ogDescription = description,
  twitterTitle,
  twitterDescription,
  ogImage,
  ogImageAlt,
  ogType = 'website',
  ogImageSize,
  noindex = false,
  breadcrumb,
  schema = true,
  path,
  toggleHref,
} = Astro.props;

const t = ui[lang];
const other: Lang = lang === 'it' ? 'en' : 'it';
const url = `${site.url}${path ?? paths[page][lang]}`;

// Default: both languages plus x-default pointing at the IT page.
const defaultAlternates: Alternate[] = [
  { hreflang: 'it', href: `${site.url}${paths[page].it}` },
  { hreflang: 'en', href: `${site.url}${paths[page].en}` },
  { hreflang: 'x-default', href: `${site.url}${paths[page].it}` },
];
const alternates = Astro.props.alternates ?? defaultAlternates;

const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${site.url}${ogImage}`;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" href="/images/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#8A3415" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Al Sicomoro" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {
      ogImageSize && (
        <>
          <meta property="og:image:width" content={String(ogImageSize.width)} />
          <meta property="og:image:height" content={String(ogImageSize.height)} />
        </>
      )
    }
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:locale:alternate" content={t.ogLocaleAlternate} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={twitterTitle ?? title} />
    <meta name="twitter:description" content={twitterDescription ?? ogDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Manrope:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    {schema && <RestaurantSchema lang={lang} />}
    {schema && breadcrumb && <BreadcrumbSchema crumbs={breadcrumb} lang={lang} />}
  </head>
  <body>
    <div id="site-header" data-page={page}>
      <Header lang={lang} page={page} toggleHref={toggleHref} />
    </div>

    <slot />

    <div id="site-footer">
      <Footer lang={lang} page={page} />
    </div>

    <script>
      import '../scripts/nav';
      import '../scripts/reveal';
    </script>
  </body>
</html>
