---
import BaseLayout from '../layouts/BaseLayout.astro';

const breadcrumb = [{"name":"Home","item":"https://alsicomoro.com"},{"name":"Menu","item":"https://alsicomoro.com/menu.html"}];

---

<BaseLayout
  lang="it"
  page="menu"
  title={"Menu | Al Sicomoro – Cucina Eritrea & Etiope Autentica"}
  description={"Menu tradizionale eritreo ed etiope a Milano. Zighinì, shiro, kitfo, injera fatta in casa e piatti vegani. Al Sicomoro Porta Venezia."}
  ogDescription={"Menu tradizionale eritreo ed etiope a Milano. Zighinì, shiro, kitfo, injera fatta in casa e piatti vegani."}
  twitterTitle={"Menu | Al Sicomoro"}
  twitterDescription={"Zighinì, shiro, kitfo, injera fatta in casa e piatti vegani."}
  ogImage="/images/zigni-overhead.jpg"
  ogImageAlt={"Traditional Eritrean zighini platter served on injera at Al Sicomoro"}
  breadcrumb={breadcrumb}
>


<!-- ===================== MENU HERO ===================== -->
<section class="hero" style="min-height:40vh; max-height:460px; height:40vh; background:var(--charcoal)" aria-label="Menu">
  <div class="hero-content" style="justify-content:center; padding-bottom:clamp(40px,6vh,60px); align-items:center; text-align:center">
    <div class="eyebrow">Il menu</div>
    <h1 style="text-align:center; max-width:16ch">Il Nostro Menù</h1>
    <p class="lead" style="text-align:center">Tutti i piatti principali sono serviti con injera — il pane tradizionale del Corno d'Africa.</p>
  </div>
</section>

<!-- ===================== FULL MENU ===================== -->
<section class="menu-section" id="menu-full">
  <div class="inner" style="padding-top:60px">
    <div style="max-width:1000px; margin:0 auto">

      <div style="text-align:center; margin-bottom:48px">
        <p style="font-size:14px; color:var(--charcoal-soft); opacity:.6; margin-bottom:10px">Scarica il menu completo in PDF</p>
        <a href="Menu_9.pdf" class="btn ghost" target="_blank" rel="noopener">Scarica PDF <span class="arrow" aria-hidden="true">↓</span></a>
      </div>

      <!-- CATEGORIA: Colazione -->
      <div class="menu-category reveal" id="cat-colazione">
        <div class="eyebrow reveal-child" style="margin-bottom:10px; text-align:center">Colazione</div>
        <div class="cat-ornament reveal-child">
          <span class="cat-ornament-line left"></span>
          <span class="cat-ornament-sym">◆ ◆ ◆</span>
          <span class="cat-ornament-line right"></span>
        </div>
        <h2 class="reveal-child" style="text-align:center; margin-bottom:32px">COLAZIONE</h2>
        <div class="mdgrid">
          <div class="mdish">
            <span class="mdish-marker"></span>
            <div class="mdish-body">
              <div class="mdish-row"><span class="mdish-name">Full</span><span class="mdish-dots"></span><span class="mdish-price">6€</span></div>
              <p class="mdish-desc">Crema di fave con pomodoro, cipolla e prezzemolo.</p>
            </div>
          </div>
          <div class="mdish">
            <span class="mdish-marker"></span>
            <div class="mdish-body">
              <div class="mdish-row"><span class="mdish-name">Frittata Al Sicomoro</span><span class="mdish-dots"></span><span class="mdish-price">8€</span></div>
              <p class="mdish-desc">Frittata con uovo, cipolla e pomodoro — piccante o non piccante.</p>
            </div>
          </div>
          <div class="mdish">
            <span class="mdish-marker"></span>
            <div class="mdish-body">
              <div class="mdish-row"><span class="mdish-name">Omelette</span><span class="mdish-dots"></span><span class="mdish-price">10€</span></div>
              <p class="mdish-desc">Uova soffici con prezzemolo o miele.</p>
            </div>
          </div>
          <div class="mdish">
            <span class="mdish-marker"></span>
            <div class="mdish-body">
              <div class="mdish-row"><span class="mdish-name">Kitcha Fit-Fit</span><span class="mdish-dots"></span><span class="mdish-price">10€</span></div>
              <span class="mdish-note">con yogurt</span>
              <p class="mdish-desc">Piadina spezzettata condita a scelta: classica, miele, spriss rosso o bianco, burro — con yogurt.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- CATEGORIA: Antipasti -->
      <div class="menu-category reveal" style="margin-top:56px" id="cat-antipasti">
        <div class="eyebrow reveal-child" style="margin-bottom:10px; text-align:center">Antipasti</div>
        <div class="cat-ornament reveal-child">
          <span class="cat-ornament-line left"></span>
          <span class="cat-ornament-sym">◆ ◆ ◆</span>
          <span class="cat-ornament-line right"></span>
        </div>
        <h2 class="reveal-child" style="text-align:center; margin-bottom:32px">ANTIPASTI TRADIZIONALI</h2>
        <div class="mdgrid">
          <div class="mdish">
            <span class="mdish-marker"></span>
            <div class="mdish-body">
              <div class="mdish-row"><span class="mdish-name">Categna</span><span class="mdish-dots"></span><span class="mdish-price">3€</span></div>
              <span class="mdish-note">4 pz</span>
              <p class="mdish-desc">Injera tostata al momento: con burro chiarificato e berberè, con lenticchie.</p>
            </div>
          </div>
          <div class="mdish">
            <span class="mdish-marker"></span>
            <div class="mdish-body">
              <div class="mdish-row"><span class="mdish-name">Sambusa di Carne</span><span class="mdish-dots"></span><span class="mdish-price">3€</span></div>
              <span class="mdish-note">2 pz · 2 varianti</span>
              <p class="mdish-desc">Fagottini ripieni con carne macinata di manzo o pollo.</p>
            </div>
          </div>
          <div class="mdish">
            <span class="mdish-marker"></span>
            <div class="mdish-body">
              <div class="mdish-row"><span class="mdish-name">Sambusa di Verdura</span><span class="mdish-dots"></span><span class="mdish-price">1,50€</span></div>
              <span class="mdish-note">1 pz</span>
              <p class="mdish-desc">Fagottini vegetariani con lenticchie o coste.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- CATEGORIA: Carne -->
      <div class="menu-category reveal" style="margin-top:56px" id="cat-carne">
        <div class="eyebrow reveal-child" style="margin-bottom:10px; text-align:center">Carne</div>
        <div class="cat-ornament reveal-child">
          <span class="cat-ornament-line left"></span>
          <span class="cat-ornament-sym">◆ ◆ ◆</span>
          <span class="cat-ornament-line right"></span>
        </div>
        <h2 class="reveal-child" style="text-align:center; margin-bottom:32px">PIATTI DI CARNE</h2>
        <div class="menu-notice reveal-child">Ogni piatto è servito con l'injera — il pane del cuore della cucina eritrea ed etiopica. Preparata con farina di teff (un antico cereale africano, naturalmente senza glutine) o con altre farine tradizionali, è soffice, leggermente acidula e piena di vita. Chiedi al personale la versione teff se hai intolleranze.</div>
        <div class="mdgrid">
          <div class="mdish">
            <span class="mdish-marker"></span>
            <div class="mdish-body">
              <div class="mdish-row"><span class="mdish-name">Zighini di Carne</span><span class="mdish-dots"></span><span class="mdish-price">17€</span></div>
              <p class="mdish-desc">Spezzatino di manzo o pollo con purè di ceci, lenticchie e insalata.</p>
            </div>
          </div>
          <div class="mdish">
            <span class="mdish-marker"></span>
            <div class="mdish-body">
              <div class="mdish-row"><span class="mdish-name">Spriss Rosso / Bianco</span><span class="mdish-dots"></span><span class="mdish-price">16€</span></div>
              <p class="mdish-desc">Bocconcini di manzo con pomodoro e spezie. Rosso: con berberè | Bianco: senza piccante.</p>
            </div>
          </div>
          <div class="mdish">
            <span class="mdish-marker"></span>
            <div class="mdish-body">
              <div class="mdish-row"><span class="mdish-name">Gored Gored</span><span class="mdish-dots"></span><span class="mdish-price">18€</span></div>
              <p class="mdish-desc">Bocconcini di manzo con burro chiarificato e spezie. Cotto, crudo o semicrudo.</p>
            </div>
          </div>
          <div class="mdish">
            <span class="mdish-marker"></span>
            <div class="mdish-body">
              <div class="mdish-row"><span class="mdish-name">Kitfo</span><span class="mdish-dots"></span><span class="mdish-price">18€</span></div>
              <p class="mdish-desc">Manzo tritato fine con burro chiarificato e mitmita. Cotto, crudo o semicrudo.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- CATEGORIA: Vegetariano -->
      <div class="menu-category reveal" style="margin-top:56px" id="cat-vegetariano">
        <div class="eyebrow reveal-child" style="margin-bottom:10px; text-align:center">Vegetariano / Vegano</div>
        <div class="cat-ornament reveal-child">
          <span class="cat-ornament-line left"></span>
          <span class="cat-ornament-sym">◆ ◆ ◆</span>
          <span class="cat-ornament-line right"></span>
        </div>
        <h2 class="reveal-child" style="text-align:center; margin-bottom:32px">VEGETARIANO / VEGANO</h2>
        <div class="menu-notice reveal-child">Ogni piatto è servito con l'injera fatta in casa. La nostra cucina vegetariana e vegana è ricca di legumi, verdure speziate e sapori autentici — naturalmente senza compromessi.</div>
        <div class="mdgrid">
          <div class="mdish">
            <span class="mdish-marker"></span>
            <div class="mdish-body">
              <div class="mdish-row"><span class="mdish-name">Zighini Vegetariano</span><span class="mdish-dots"></span><span class="mdish-price">16€</span></div>
              <p class="mdish-desc">Lenticchie rosse e gialle, insalata, shiro (crema di ceci), hamli (coste), alicia (cavolo, fagioli e patate), rapa con carote.</p>
            </div>
          </div>
          <div class="mdish">
            <span class="mdish-marker"></span>
            <div class="mdish-body">
              <div class="mdish-row"><span class="mdish-name">Fir Fir con Uova</span><span class="mdish-dots"></span><span class="mdish-price">18€</span></div>
              <p class="mdish-desc">Injera saltata in padella con pomodoro, cipolla e berberè.</p>
            </div>
          </div>
          <div class="mdish">
            <span class="mdish-marker"></span>
            <div class="mdish-body">
              <div class="mdish-row"><span class="mdish-name">Fir Fir Vegetariano</span><span class="mdish-dots"></span><span class="mdish-price">15€</span></div>
              <p class="mdish-desc">Come il Fir Fir, nella versione senza uova.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- CATEGORIA: Dolci -->
      <div class="menu-category reveal" style="margin-top:56px" id="cat-dolci">
        <div class="eyebrow reveal-child" style="margin-bottom:10px; text-align:center">Dolci</div>
        <div class="cat-ornament reveal-child">
          <span class="cat-ornament-line left"></span>
          <span class="cat-ornament-sym">◆ ◆ ◆</span>
          <span class="cat-ornament-line right"></span>
        </div>
        <h2 class="reveal-child" style="text-align:center; margin-bottom:32px">DOLCI FATTI IN CASA</h2>
        <div class="mdgrid">
          <div class="mdish">
            <span class="mdish-marker"></span>
            <div class="mdish-body">
              <div class="mdish-row"><span class="mdish-name">Dolce del giorno</span><span class="mdish-dots"></span><span class="mdish-price">3€</span></div>
              <p class="mdish-desc">Preparazione casalinga che cambia ogni giorno.</p>
            </div>
          </div>
          <div class="mdish">
            <span class="mdish-marker"></span>
            <div class="mdish-body">
              <div class="mdish-row"><span class="mdish-name">Macedonia di frutta</span><span class="mdish-dots"></span><span class="mdish-price">5€</span></div>
              <p class="mdish-desc">Frutta fresca di stagione.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- CATEGORIA: Bevande -->
      <div class="menu-category reveal" style="margin-top:56px" id="cat-bevande">
        <div class="eyebrow reveal-child" style="margin-bottom:10px; text-align:center">Bevande</div>
        <div class="cat-ornament reveal-child">
          <span class="cat-ornament-line left"></span>
          <span class="cat-ornament-sym">◆ ◆ ◆</span>
          <span class="cat-ornament-line right"></span>
        </div>
        <h2 class="reveal-child" style="text-align:center; margin-bottom:32px">BEVANDE</h2>
        <div class="mdgrid">
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Acqua 0,75cl</span><span class="mdish-dots"></span><span class="mdish-price">3,00€</span></div></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Bibite in vetro</span><span class="mdish-dots"></span><span class="mdish-price">3,50€</span></div></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Birra 33cl</span><span class="mdish-dots"></span><span class="mdish-price">4,00€</span></div></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Birra 66cl</span><span class="mdish-dots"></span><span class="mdish-price">7,00€</span></div></div></div>
          <div class="mdish">
            <span class="mdish-marker"></span>
            <div class="mdish-body">
              <div class="mdish-row"><span class="mdish-name">Birra Eritrea / Etiope</span><span class="mdish-dots"></span><span class="mdish-price">5,00€</span></div>
              <p class="mdish-desc">Birra tipica</p>
            </div>
          </div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Birra Analcolica</span><span class="mdish-dots"></span><span class="mdish-price">4,00€</span></div></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Amari</span><span class="mdish-dots"></span><span class="mdish-price">4,00€</span></div></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Caffè</span></div></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Tè</span></div></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Vino — calice</span><span class="mdish-dots"></span><span class="mdish-price">4,00€</span></div></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Vino — mezzo litro</span><span class="mdish-dots"></span><span class="mdish-price">9,00€</span></div></div></div>
        </div>
      </div>

      <!-- CATEGORIA: Vini -->
      <div class="menu-category reveal" style="margin-top:56px" id="cat-vini">
        <div class="eyebrow reveal-child" style="margin-bottom:10px; text-align:center">Vini</div>
        <div class="cat-ornament reveal-child">
          <span class="cat-ornament-line left"></span>
          <span class="cat-ornament-sym">◆ ◆ ◆</span>
          <span class="cat-ornament-line right"></span>
        </div>
        <h2 class="reveal-child" style="text-align:center; margin-bottom:12px">VINI DEL SUDAFRICA · 0,75 lt</h2>
        <p class="reveal-child" style="text-align:center; font-style:italic; color:rgba(244,236,216,.5); margin-bottom:32px">Una selezione di vini dal Sudafrica — un continente, tanti terroir, una storia nel bicchiere.</p>
        <div class="mdgrid">
          <div class="mdish">
            <span class="mdish-marker"></span>
            <div class="mdish-body">
              <div class="mdish-row"><span class="mdish-name">Shiraz 2023 · Cape Dreams</span><span class="mdish-dots"></span><span class="mdish-price">18,00€</span></div>
              <p class="mdish-desc">Robertson. Violette, frutta caramellata, spezie e sentori fumosi. Finale lunghissimo.</p>
            </div>
          </div>
          <div class="mdish">
            <span class="mdish-marker"></span>
            <div class="mdish-body">
              <div class="mdish-row"><span class="mdish-name">Signature Pinotage 2023 · Spier</span><span class="mdish-dots"></span><span class="mdish-price">21,00€</span></div>
              <p class="mdish-desc">Western Cape. Ciliegie mature, prugne succose e cannella. Tannini morbidi e setosi.</p>
            </div>
          </div>
          <div class="mdish">
            <span class="mdish-marker"></span>
            <div class="mdish-body">
              <div class="mdish-row"><span class="mdish-name">221 Special Cuvée 2022 · Alvi's Drift</span><span class="mdish-dots"></span><span class="mdish-price">26,00€</span></div>
              <p class="mdish-desc">Worcester. Blend premiato: prugne mature, spezie e liquirizia. Corposo, grande persistenza.</p>
            </div>
          </div>
          <div class="mdish">
            <span class="mdish-marker"></span>
            <div class="mdish-body">
              <div class="mdish-row"><span class="mdish-name">Shiraz 2023 · Diemersdal</span><span class="mdish-dots"></span><span class="mdish-price">35,00€</span></div>
              <p class="mdish-desc">Cape Town. 12 mesi in barrique. Pepe, melograno, cioccolato fondente. Finale lungo e speziato.</p>
            </div>
          </div>
          <div class="mdish">
            <span class="mdish-marker"></span>
            <div class="mdish-body">
              <div class="mdish-row"><span class="mdish-name">Chenin Blanc 2025 · Cape Dreams</span><span class="mdish-dots"></span><span class="mdish-price">18,00€</span></div>
              <p class="mdish-desc">Robertson. Ananas, pesca, pere, agrumi. Fresco, bilanciato, fine.</p>
            </div>
          </div>
          <div class="mdish">
            <span class="mdish-marker"></span>
            <div class="mdish-body">
              <div class="mdish-row"><span class="mdish-name">Sauvignon Blanc 2025 · Spier</span><span class="mdish-dots"></span><span class="mdish-price">21,00€</span></div>
              <p class="mdish-desc">Western Cape. Uva spina, frutto della passione, peperoni verdi e frutta tropicale.</p>
            </div>
          </div>
          <div class="mdish">
            <span class="mdish-marker"></span>
            <div class="mdish-body">
              <div class="mdish-row"><span class="mdish-name">Chenin Blanc 2024 · Alvi's Drift</span><span class="mdish-dots"></span><span class="mdish-price">26,00€</span></div>
              <p class="mdish-desc">Western Cape. Pesche bianche, nettarine, acidità elegante. Corpo pieno e strutturato.</p>
            </div>
          </div>
          <div class="mdish">
            <span class="mdish-marker"></span>
            <div class="mdish-body">
              <div class="mdish-row"><span class="mdish-name">Unwooded Chardonnay 2025 · Diemersdal</span><span class="mdish-dots"></span><span class="mdish-price">28,00€</span></div>
              <p class="mdish-desc">Cape Town. Mela, melone, lime. Cremoso e persistente.</p>
            </div>
          </div>
          <div class="mdish">
            <span class="mdish-marker"></span>
            <div class="mdish-body">
              <div class="mdish-row"><span class="mdish-name">Brut Cuvée · Finch Mountain</span><span class="mdish-dots"></span><span class="mdish-price">18,00€</span></div>
              <p class="mdish-desc">Western Cape Sauvignon Blanc metodo Charmat. Vivace, fresco, erbe secche e agrumi.</p>
            </div>
          </div>
          <div class="mdish">
            <span class="mdish-marker"></span>
            <div class="mdish-body">
              <div class="mdish-row"><span class="mdish-name">Borealis Cuvée Brut 2024 · Krone</span><span class="mdish-dots"></span><span class="mdish-price">33,00€</span></div>
              <p class="mdish-desc">Western Cape Chardonnay + Pinot Noir, 12 mesi sui lieviti. Ananas, lime, crosta di pane.</p>
            </div>
          </div>
          <div class="mdish">
            <span class="mdish-marker"></span>
            <div class="mdish-body">
              <div class="mdish-row"><span class="mdish-name">Rosé Cuvée Brut 2023 · Krone</span><span class="mdish-dots"></span><span class="mdish-price">33,00€</span></div>
              <p class="mdish-desc">Western Cape. Pinot Noir + Chardonnay, 12 mesi sui lieviti. Melograno, frutti di bosco, secco ed elegante.</p>
            </div>
          </div>
        </div>
      </div>


    </div>
  </div>
</section>
</BaseLayout>
