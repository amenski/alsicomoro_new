---
import BaseLayout from '../../layouts/BaseLayout.astro';

---

<BaseLayout
  lang="en"
  page="404"
  title={"Page not found | Al Sicomoro"}
  description={"The page you're looking for doesn't exist. Return to the Al Sicomoro home or explore our Eritrean and Ethiopian menu in Milan, Porta Venezia."}
  ogDescription={"The page you're looking for doesn't exist. Return to the home or explore our menu."}
  twitterTitle={"Page not found | Al Sicomoro"}
  twitterDescription={"The page you're looking for doesn't exist. Return to the home or explore our menu."}
  ogImage="/images/tree.jpg"
  ogImageAlt={"The sycamore tree, symbol of Al Sicomoro restaurant in Milan"}
  noindex
  alternates={[]}
  schema={false}
>


<!-- ===================== 404 HERO ===================== -->
<section class="hero" style="min-height:60vh; max-height:640px; height:60vh; background:var(--ink)" aria-label="Page not found">
  <div class="hero-content" style="justify-content:center; align-items:center; text-align:center">
    <div class="eyebrow">Error 404</div>
    <div class="error-code" aria-hidden="true">404</div>
    <h1 style="text-align:center; max-width:18ch">This page doesn't exist</h1>
    <p class="lead" style="text-align:center">Maybe it was an off-menu dish. Head back home or see what we're serving today.</p>
    <div class="hero-cta" style="justify-content:center; margin-top:8px">
      <a href="/en/" class="btn">Back to home <span class="arrow" aria-hidden="true">→</span></a>
      <a href="/en/menu.html" class="btn ghost">Explore the Menu</a>
    </div>
  </div>
</section>
</BaseLayout>
