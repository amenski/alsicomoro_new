---
import BaseLayout from '../../layouts/BaseLayout.astro';

const breadcrumb = [{"name":"Home","item":"https://alsicomoro.com/en/"},{"name":"Menu","item":"https://alsicomoro.com/en/menu.html"}];

---

<BaseLayout
  lang="en"
  page="menu"
  title={"Menu | Al Sicomoro – Authentic Eritrean & Ethiopian Cuisine"}
  description={"Traditional Eritrean and Ethiopian menu in Milan. Zighini, shiro, kitfo, homemade injera and vegan dishes. Al Sicomoro Porta Venezia."}
  ogDescription={"Traditional Eritrean and Ethiopian menu in Milan. Zighini, shiro, kitfo, homemade injera and vegan dishes."}
  twitterTitle={"Menu | Al Sicomoro"}
  twitterDescription={"Zighini, shiro, kitfo, homemade injera and vegan dishes."}
  ogImage="/images/zigni-overhead.jpg"
  ogImageAlt={"Traditional Eritrean zighini platter served on injera at Al Sicomoro"}
  breadcrumb={breadcrumb}
>


<!-- MENU HERO -->
<section class="hero" style="min-height:40vh; max-height:460px; height:40vh; background:var(--charcoal)" aria-label="Menu">
  <div class="hero-content" style="justify-content:center; padding-bottom:clamp(40px,6vh,60px); align-items:center; text-align:center">
    <div class="eyebrow">The menu</div>
    <h1 style="text-align:center; max-width:16ch">Our Menu</h1>
    <p class="lead" style="text-align:center">All main dishes are served with injera — the traditional bread of the Horn of Africa.</p>
  </div>
</section>

<!-- FULL MENU -->
<section class="menu-section" id="menu-full">
  <div class="inner" style="padding-top:60px">
    <div style="max-width:1000px; margin:0 auto">

      <div style="text-align:center; margin-bottom:48px">
        <p style="font-size:14px; color:var(--charcoal-soft); opacity:.6; margin-bottom:10px">Download the complete menu PDF</p>
        <a href="/Menu_9.pdf" class="btn ghost" target="_blank" rel="noopener">Download PDF <span class="arrow" aria-hidden="true">↓</span></a>
      </div>

      <!-- BREAKFAST -->
      <div class="menu-category reveal" id="cat-colazione">
        <div class="eyebrow reveal-child" style="margin-bottom:10px; text-align:center">Breakfast</div>
        <div class="cat-ornament reveal-child">
          <span class="cat-ornament-line left"></span>
          <span class="cat-ornament-sym">◆ ◆ ◆</span>
          <span class="cat-ornament-line right"></span>
        </div>
        <h2 class="reveal-child" style="text-align:center; margin-bottom:32px">BREAKFAST</h2>
        <div class="mdgrid">
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Full</span><span class="mdish-dots"></span><span class="mdish-price">€6</span></div><p class="mdish-desc">Fava bean cream with tomato, onion and parsley.</p></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Al Sicomoro Frittata</span><span class="mdish-dots"></span><span class="mdish-price">€8</span></div><p class="mdish-desc">Frittata with egg, onion and tomato — spicy or not spicy.</p></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Omelette</span><span class="mdish-dots"></span><span class="mdish-price">€10</span></div><p class="mdish-desc">Fluffy eggs with parsley or honey.</p></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Kitcha Fit-Fit</span><span class="mdish-dots"></span><span class="mdish-price">€10</span></div><span class="mdish-note">with yogurt</span><p class="mdish-desc">Broken flatbread dressed to choice: classic, honey, red or white spriss, butter — with yogurt.</p></div></div>
        </div>
      </div>

      <!-- APPETIZERS -->
      <div class="menu-category reveal" style="margin-top:56px" id="cat-antipasti">
        <div class="eyebrow reveal-child" style="margin-bottom:10px; text-align:center">Appetizers</div>
        <div class="cat-ornament reveal-child"><span class="cat-ornament-line left"></span><span class="cat-ornament-sym">◆ ◆ ◆</span><span class="cat-ornament-line right"></span></div>
        <h2 class="reveal-child" style="text-align:center; margin-bottom:32px">TRADITIONAL APPETIZERS</h2>
        <div class="mdgrid">
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Categna</span><span class="mdish-dots"></span><span class="mdish-price">€3</span></div><span class="mdish-note">4 pcs</span><p class="mdish-desc">Freshly toasted injera: with clarified butter and berbere, with lentils.</p></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Meat Sambusa</span><span class="mdish-dots"></span><span class="mdish-price">€3</span></div><span class="mdish-note">2 pcs · 2 variants</span><p class="mdish-desc">Filled pastries with minced beef or chicken.</p></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Vegetable Sambusa</span><span class="mdish-dots"></span><span class="mdish-price">€1,50</span></div><span class="mdish-note">1 pc</span><p class="mdish-desc">Vegetarian pastries with lentils or chard.</p></div></div>
        </div>
      </div>

      <!-- MEAT -->
      <div class="menu-category reveal" style="margin-top:56px" id="cat-carne">
        <div class="eyebrow reveal-child" style="margin-bottom:10px; text-align:center">Meat</div>
        <div class="cat-ornament reveal-child"><span class="cat-ornament-line left"></span><span class="cat-ornament-sym">◆ ◆ ◆</span><span class="cat-ornament-line right"></span></div>
        <h2 class="reveal-child" style="text-align:center; margin-bottom:32px">MEAT DISHES</h2>
        <div class="menu-notice reveal-child">Every dish is served with injera — the heartbread of Eritrean and Ethiopian cuisine. Made with teff flour (an ancient African grain, naturally gluten-free) or other traditional flours, it is soft, slightly tangy and full of life. Ask the staff for the teff version if you have intolerances.</div>
        <div class="mdgrid">
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Meat Zighini</span><span class="mdish-dots"></span><span class="mdish-price">€17</span></div><p class="mdish-desc">Beef or chicken stew with chickpea puree, lentils and salad.</p></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Red / White Spriss</span><span class="mdish-dots"></span><span class="mdish-price">€16</span></div><p class="mdish-desc">Beef chunks with tomato and spices. Red: with berbere | White: no spice.</p></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Gored Gored</span><span class="mdish-dots"></span><span class="mdish-price">€18</span></div><p class="mdish-desc">Beef chunks with clarified butter and spices. Cooked, raw or rare.</p></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Kitfo</span><span class="mdish-dots"></span><span class="mdish-price">€18</span></div><p class="mdish-desc">Finely minced beef with clarified butter and mitmita. Cooked, raw or rare.</p></div></div>
        </div>
      </div>

      <!-- VEGETARIAN / VEGAN -->
      <div class="menu-category reveal" style="margin-top:56px" id="cat-vegetariano">
        <div class="eyebrow reveal-child" style="margin-bottom:10px; text-align:center">Vegetarian / Vegan</div>
        <div class="cat-ornament reveal-child"><span class="cat-ornament-line left"></span><span class="cat-ornament-sym">◆ ◆ ◆</span><span class="cat-ornament-line right"></span></div>
        <h2 class="reveal-child" style="text-align:center; margin-bottom:32px">VEGETARIAN / VEGAN</h2>
        <div class="menu-notice reveal-child">Every dish is served with homemade injera. Our vegetarian and vegan cuisine is rich in legumes, spiced vegetables and authentic flavours — naturally, without compromise.</div>
        <div class="mdgrid">
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Vegetarian Zighini</span><span class="mdish-dots"></span><span class="mdish-price">€16</span></div><p class="mdish-desc">Red and yellow lentils, salad, shiro (chickpea puree), hamli (chard), alicia (cabbage, beans and potatoes), turnip with carrots.</p></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Fir Fir with Eggs</span><span class="mdish-dots"></span><span class="mdish-price">€18</span></div><p class="mdish-desc">Injera sautéed with tomato, onion and berbere.</p></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Vegetarian Fir Fir</span><span class="mdish-dots"></span><span class="mdish-price">€15</span></div><p class="mdish-desc">Like Fir Fir, in the egg-free version.</p></div></div>
        </div>
      </div>

      <!-- DESSERTS -->
      <div class="menu-category reveal" style="margin-top:56px" id="cat-dolci">
        <div class="eyebrow reveal-child" style="margin-bottom:10px; text-align:center">Desserts</div>
        <div class="cat-ornament reveal-child"><span class="cat-ornament-line left"></span><span class="cat-ornament-sym">◆ ◆ ◆</span><span class="cat-ornament-line right"></span></div>
        <h2 class="reveal-child" style="text-align:center; margin-bottom:32px">HOMEMADE DESSERTS</h2>
        <div class="mdgrid">
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Dessert of the day</span><span class="mdish-dots"></span><span class="mdish-price">€3</span></div><p class="mdish-desc">Homemade preparation that changes daily.</p></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Fruit salad</span><span class="mdish-dots"></span><span class="mdish-price">€5</span></div><p class="mdish-desc">Fresh seasonal fruit.</p></div></div>
        </div>
      </div>

      <!-- BEVERAGES -->
      <div class="menu-category reveal" style="margin-top:56px" id="cat-bevande">
        <div class="eyebrow reveal-child" style="margin-bottom:10px; text-align:center">Beverages</div>
        <div class="cat-ornament reveal-child"><span class="cat-ornament-line left"></span><span class="cat-ornament-sym">◆ ◆ ◆</span><span class="cat-ornament-line right"></span></div>
        <h2 class="reveal-child" style="text-align:center; margin-bottom:32px">BEVERAGES</h2>
        <div class="mdgrid">
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Water 0.75cl</span><span class="mdish-dots"></span><span class="mdish-price">€3.00</span></div></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Soft drinks in glass</span><span class="mdish-dots"></span><span class="mdish-price">€3.50</span></div></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Beer 33cl</span><span class="mdish-dots"></span><span class="mdish-price">€4.00</span></div></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Beer 66cl</span><span class="mdish-dots"></span><span class="mdish-price">€7.00</span></div></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Eritrean / Ethiopian Beer</span><span class="mdish-dots"></span><span class="mdish-price">€5.00</span></div><p class="mdish-desc">Traditional beer</p></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Non-alcoholic beer</span><span class="mdish-dots"></span><span class="mdish-price">€4.00</span></div></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Bitters</span><span class="mdish-dots"></span><span class="mdish-price">€4.00</span></div></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Coffee</span></div></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Tea</span></div></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Wine — glass</span><span class="mdish-dots"></span><span class="mdish-price">€5.50</span></div></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Wine — half litre</span><span class="mdish-dots"></span><span class="mdish-price">€14.00</span></div></div></div>
        </div>
      </div>

      <!-- WINES -->
      <div class="menu-category reveal" style="margin-top:56px" id="cat-vini">
        <div class="eyebrow reveal-child" style="margin-bottom:10px; text-align:center">Wines</div>
        <div class="cat-ornament reveal-child"><span class="cat-ornament-line left"></span><span class="cat-ornament-sym">◆ ◆ ◆</span><span class="cat-ornament-line right"></span></div>
        <h2 class="reveal-child" style="text-align:center; margin-bottom:32px">SOUTH AFRICAN WINES · 0.75 lt</h2>
        <div class="menu-notice reveal-child">A selection of wines from South Africa — one continent, many terroirs, a story in the glass.</div>
        <div class="mdgrid">
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Robertson Shiraz</span><span class="mdish-dots"></span><span class="mdish-price">€28</span></div><p class="mdish-desc">Robertson. Violets, caramelized fruit, spices and smoky notes. Very long finish.</p></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Western Cape Pinotage</span><span class="mdish-dots"></span><span class="mdish-price">€28</span></div><p class="mdish-desc">Western Cape. Ripe cherries, juicy plums and cinnamon. Soft and silky tannins.</p></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Worcester Blend</span><span class="mdish-dots"></span><span class="mdish-price">€28</span></div><p class="mdish-desc">Worcester. Award-winning blend: ripe plums, spices and liquorice. Full-bodied, great persistence.</p></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Cape Town Shiraz</span><span class="mdish-dots"></span><span class="mdish-price">€28</span></div><p class="mdish-desc">Cape Town. 12 months in barrique. Pepper, pomegranate, dark chocolate. Long, spicy finish.</p></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Robertson Sauvignon Blanc</span><span class="mdish-dots"></span><span class="mdish-price">€26</span></div><p class="mdish-desc">Robertson. Pineapple, peach, pear, citrus. Fresh, balanced, refined.</p></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Western Cape Sauvignon Blanc</span><span class="mdish-dots"></span><span class="mdish-price">€26</span></div><p class="mdish-desc">Western Cape. Gooseberry, passion fruit, green peppers and tropical fruit.</p></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Western Cape Chenin Blanc</span><span class="mdish-dots"></span><span class="mdish-price">€26</span></div><p class="mdish-desc">Western Cape. White peaches, nectarines, elegant acidity. Full-bodied and structured.</p></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Cape Town Chardonnay</span><span class="mdish-dots"></span><span class="mdish-price">€28</span></div><p class="mdish-desc">Cape Town. Apple, melon, lime. Creamy and persistent. ★ 4 Stars Platter's 2025</p></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Western Cape Sauvignon Blanc Brut</span><span class="mdish-dots"></span><span class="mdish-price">€26</span></div><p class="mdish-desc">Western Cape Sauvignon Blanc Charmat method. Lively, fresh, dry herbs and citrus.</p></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Western Cape Blanc de Blancs</span><span class="mdish-dots"></span><span class="mdish-price">€28</span></div><p class="mdish-desc">Western Cape Chardonnay + Pinot Noir, 12 months on lees. Pineapple, lime, bread crust.</p></div></div>
          <div class="mdish"><span class="mdish-marker"></span><div class="mdish-body"><div class="mdish-row"><span class="mdish-name">Western Cape Brut Rosé</span><span class="mdish-dots"></span><span class="mdish-price">€28</span></div><p class="mdish-desc">Western Cape. Pinot Noir + Chardonnay, 12 months on lees. Pomegranate, berries, dry and elegant.</p></div></div>
        </div>
      </div>

    </div>
  </div>
</section>
</BaseLayout>
