---
import { Image, Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import heroZigni from '../assets/images/background.jpg';
import slideZigni from '../assets/images/zigni-overhead.jpg';
import slideTree from '../assets/images/tree.jpg';
import cardZigni from '../assets/images/zigni-overhead.jpg';
import cardKitfo from '../assets/images/kitfo.jpg';
import cardSambusa from '../assets/images/sambusa-di-carne.jpg';
import cardVegan from '../assets/images/vegan.jpg';
import cardGored from '../assets/images/gored_gored.jpeg';
import cardFirfir from '../assets/images/firfir.jpg';
import storyTree from '../assets/images/tree.jpg';

const breadcrumb = [{"name":"Home","item":"https://alsicomoro.com"}];

---

<BaseLayout
  lang="it"
  page="index"
  title={"Al Sicomoro — Ristorante Eritreo & Etiope a Milano Porta Venezia"}
  description={"Cucina del Corno d'Africa nel cuore di Porta Venezia. Injera fatta in casa, zighinì, kitfo, shiro. Via Panfilo Castaldi 19, Milano."}
  ogDescription={"Cucina del Corno d'Africa nel cuore di Porta Venezia. Injera fatta in casa, zighinì, kitfo, shiro."}
  twitterTitle={"Al Sicomoro — Ristorante Eritreo & Etiope a Milano"}
  twitterDescription={"Cucina del Corno d'Africa nel cuore di Porta Venezia."}
  ogImage="/images/background.jpg"
  ogImageAlt={"Al Sicomoro restaurant atmosphere in Porta Venezia, Milan"}
  ogType="restaurant.restaurant"
  ogImageSize={{"width":1920,"height":1080}}
  breadcrumb={breadcrumb}
>


<!-- ===================== HERO SLIDER ===================== -->
<section class="hero" aria-label="Galleria principale">
  <div class="slides" id="slides">
    <div class="slide active" data-caption="Zighinì misto · piatto della casa">
      <Picture class="slide-img" src={heroZigni} alt="Piatto di zighinì servito sull'injera al Sicomoro" formats={['avif', 'webp']} widths={[480, 768, 1080, 1296]} sizes="100vw" loading="eager" fetchpriority="high" />
      <div class="slide-caption">01 — Zighinì misto · piatto della casa</div>
    </div>
    <div class="slide" data-caption="Mani che condividono · si mangia insieme">
      <Picture class="slide-img" src={slideZigni} alt="Tavola condivisa con piatti tradizionali eritrei" formats={['avif', 'webp']} widths={[480, 768, 1080, 1296]} sizes="100vw" loading="lazy" />
      <div class="slide-caption">02 — Mani che condividono</div>
    </div>
    <div class="slide" data-caption="Atmosfera · sala del ristorante">
      <Picture class="slide-img" src={slideTree} alt="Interno del ristorante Al Sicomoro" formats={['avif', 'webp']} widths={[480, 768, 1080, 1296]} sizes="100vw" loading="lazy" />
      <div class="slide-caption">03 — Sala del ristorante</div>
    </div>
  </div>

  <div class="hero-content">
    <div class="eyebrow">Cucina del Corno d'Africa</div>
    <h1>Sotto al <em>sicomoro</em>, la tradizione si racconta.</h1>
    <p class="lead">Un ristorante eritreo ed etiope nel cuore di Porta Venezia. Injera fatta in casa, spezie macinate al momento, ricette tramandate da generazioni.</p>
    <div class="hero-cta">
      <a href="/contatti.html" class="btn">Prenota un tavolo <span class="arrow" aria-hidden="true">→</span></a>
      <a href="#menu" class="btn ghost">Scopri il menu</a>
    </div>
  </div>

  <div class="hero-stats" aria-label="Riconoscimenti">
    <div class="stat"><div class="num">9.7</div><div class="label">TheFork</div></div>
    <div class="stat"><div class="num">10+</div><div class="label">Piatti</div></div>
  </div>

  <button class="slider-arrow slider-prev" aria-label="Slide precedente" id="sliderPrev">‹</button>
  <button class="slider-arrow slider-next" aria-label="Slide successiva" id="sliderNext">›</button>
  <div class="slider-dots" role="tablist" aria-label="Seleziona slide">
    <button class="slider-dot active" data-slide="0" aria-label="Slide 1" aria-selected="true"></button>
    <button class="slider-dot" data-slide="1" aria-label="Slide 2" aria-selected="false"></button>
    <button class="slider-dot" data-slide="2" aria-label="Slide 3" aria-selected="false"></button>
  </div>
</section>

<!-- ===================== MARQUEE ===================== -->
<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    <span>
      Injera <span class="sep">✦</span> Zighinì <span class="sep">✦</span> Kitfo <span class="sep">✦</span> Shiro <span class="sep">✦</span> Tibs <span class="sep">✦</span> Berberè <span class="sep">✦</span>
    </span>
    <span>
      Injera <span class="sep">✦</span> Zighinì <span class="sep">✦</span> Kitfo <span class="sep">✦</span> Shiro <span class="sep">✦</span> Tibs <span class="sep">✦</span> Berberè <span class="sep">✦</span>
    </span>
  </div>
</div>

<!-- ===================== STORIA ===================== -->
<section class="section" id="storia">
  <div class="story-grid">
    <div class="story-image reveal">
      <Image src={storyTree} alt="La cucina del ristorante Al Sicomoro" widths={[400, 800]} sizes="(min-width: 900px) 42vw, 100vw" loading="lazy" />
      <span class="badge">La nostra storia</span>
      <div class="label">"Tradizione, sapore, comunità."</div>
    </div>
    <div class="story-text reveal">
      <div class="eyebrow reveal-child">Chi siamo</div>
      <h2 class="reveal-child">Una tavola che unisce due rive.</h2>
      <p class="reveal-child">Al Sicomoro nasce dall'incontro fra due culture e una stessa idea di ospitalità: la convivialità della tavola condivisa, il ritmo lento delle spezie, il calore dell'injera che arriva al centro come una mappa di sapori.</p>
      <p class="reveal-child">Ogni mattina prepariamo l'injera secondo la tradizione, lasciando fermentare la pasta di teff per giorni. Le carni vengono marinate nel berberè della casa — una miscela di oltre dodici spezie tostate e macinate da noi.</p>
      <blockquote class="story-quote reveal-child">
        "Mangiare con le mani non è folklore. È un modo di ricordare che il cibo passa prima dal cuore."
        <cite>— Famiglia Al Sicomoro</cite>
      </blockquote>
      <a href="#esperienza" class="btn ghost reveal-child">L'esperienza al tavolo →</a>
    </div>
  </div>
</section>

<!-- ===================== MENU ===================== -->
<section class="menu-section" id="menu">
  <div class="inner">
    <div class="menu-head reveal">
      <div class="eyebrow reveal-child" style="margin-bottom:16px">Il menu</div>
      <h2 class="reveal-child">Piatti che si raccontano.</h2>
    </div>

    <div class="menu-tabs reveal" role="tablist" aria-label="Filtra menu">
      <a href="Menu_9.pdf" class="menu-tab" target="_blank" rel="noopener" style="display:flex;align-items:center;gap:6px;text-decoration:none">Scarica PDF <span aria-hidden="true">↓</span></a>
      <button class="menu-tab active" data-filter="tutti" role="tab" aria-selected="true">Tutti</button>
      <button class="menu-tab" data-filter="carne" role="tab" aria-selected="false">Carne</button>
      <button class="menu-tab" data-filter="vegetariano" role="tab" aria-selected="false">Vegetariano</button>
      <button class="menu-tab" data-filter="antipasti" role="tab" aria-selected="false">Antipasti</button>
    </div>

    <div class="menu-grid" id="menuGrid">
      <article class="dish reveal" data-category="carne">
        <div class="dish-img">
          <Image src={cardZigni} alt="Zighinì di carne" widths={[92, 184]} sizes="92px" loading="lazy" />
        </div>
        <div class="dish-body">
          <div class="dish-row">
            <h3>Zighinì di carne</h3>
            <span class="dish-dots"></span>
            <span class="price">€17</span>
          </div>
          <p class="desc">Spezzatino di manzo o pollo cotto a lungo nel berberè della casa, servito sull'injera con purè di ceci, lenticchie e insalata.</p>
        </div>
      </article>

      <article class="dish reveal" data-category="carne">
        <div class="dish-img">
          <Image src={cardKitfo} alt="Kitfo" widths={[92, 184]} sizes="92px" loading="lazy" />
        </div>
        <div class="dish-body">
          <div class="dish-row">
            <h3>Kitfo</h3>
            <span class="dish-tag">Specialità</span>
            <span class="dish-dots"></span>
            <span class="price">€18</span>
          </div>
          <p class="desc">Manzo tritato fine con burro chiarificato e mitmita. Disponibile cotto, crudo o semicrudo secondo tradizione.</p>
        </div>
      </article>


      <article class="dish reveal" data-category="antipasti">
        <div class="dish-img">
          <Image src={cardSambusa} alt="Sambusa di carne" widths={[92, 184]} sizes="92px" loading="lazy" />
        </div>
        <div class="dish-body">
          <div class="dish-row">
            <h3>Sambusa di carne</h3>
            <span class="dish-tag">Antipasto</span>
            <span class="dish-dots"></span>
            <span class="price">€3</span>
          </div>
          <p class="desc">Fagottini croccanti ripieni con carne macinata di manzo o pollo, fritti al momento. Due varianti a scelta.</p>
        </div>
      </article>

      <article class="dish reveal" data-category="vegano vegetariano">
        <div class="dish-img">
          <Image src={cardVegan} alt="Zighinì vegetariano" widths={[92, 184]} sizes="92px" loading="lazy" />
        </div>
        <div class="dish-body">
          <div class="dish-row">
            <h3>Zighinì vegetariano</h3>
            <span class="dish-tag vegan">Vegano</span>
            <span class="dish-dots"></span>
            <span class="price">€16</span>
          </div>
          <p class="desc">Lenticchie rosse e gialle, shiro (crema di ceci), hamli (coste), alicia (cavolo, fagioli e patate), rapa con carote e insalata. Servito sull'injera.</p>
        </div>
      </article>

      <article class="dish reveal" data-category="carne">
        <div class="dish-img">
          <Image src={cardGored} alt="Gored Gored" widths={[92, 184]} sizes="92px" loading="lazy" />
        </div>
        <div class="dish-body">
          <div class="dish-row">
            <h3>Gored Gored</h3>
            <span class="dish-dots"></span>
            <span class="price">€18</span>
          </div>
          <p class="desc">Bocconcini di manzo con burro chiarificato e spezie. Cotto, crudo o semicrudo.</p>
        </div>
      </article>

      <article class="dish reveal" data-category="vegano vegetariano">
        <div class="dish-img">
          <Image src={cardFirfir} alt="Fir Fir vegetariano" widths={[92, 184]} sizes="92px" loading="lazy" />
        </div>
        <div class="dish-body">
          <div class="dish-row">
            <h3>Fir Fir vegetariano</h3>
            <span class="dish-tag vegan">Vegano</span>
            <span class="dish-dots"></span>
            <span class="price">€15</span>
          </div>
          <p class="desc">Injera saltata in padella con pomodoro, cipolla e berberè, nella versione senza uova.</p>
        </div>
      </article>

      <article class="dish reveal" data-category="carne">
        <div class="dish-img">
          <Image src={cardZigni} alt="Spriss rosso e bianco" widths={[92, 184]} sizes="92px" loading="lazy" />
        </div>
        <div class="dish-body">
          <div class="dish-row">
            <h3>Spriss Rosso / Bianco</h3>
            <span class="dish-dots"></span>
            <span class="price">€16</span>
          </div>
          <p class="desc">Bocconcini di manzo con pomodoro e spezie. Rosso: con berberè | Bianco: senza piccante.</p>
        </div>
      </article>

      <article class="dish reveal" data-category="antipasti">
        <div class="dish-img">
          <Image src={cardZigni} alt="Categna" widths={[92, 184]} sizes="92px" loading="lazy" />
        </div>
        <div class="dish-body">
          <div class="dish-row">
            <h3>Categna</h3>
            <span class="dish-dots"></span>
            <span class="price">€3</span>
          </div>
          <p class="desc">Injera tostata al momento: con burro chiarificato e berberè, o con lenticchie.</p>
        </div>
      </article>

      <article class="dish reveal" data-category="antipasti">
        <div class="dish-img">
          <Image src={cardSambusa} alt="Sambusa di verdura" widths={[92, 184]} sizes="92px" loading="lazy" />
        </div>
        <div class="dish-body">
          <div class="dish-row">
            <h3>Sambusa di verdura</h3>
            <span class="dish-tag vegan">Vegetariano</span>
            <span class="dish-dots"></span>
            <span class="price">€1,50</span>
          </div>
          <p class="desc">Fagottini vegetariani con lenticchie o coste.</p>
        </div>
      </article>
    </div>

    <div class="menu-empty" id="menuEmpty">Nessun piatto in questa categoria.</div>

    <div style="text-align:center; margin-top:40px">
      <a href="/menu.html" class="btn ghost">Vedi il menu completo <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<!-- ===================== ESPERIENZA ===================== -->
<section class="exp" id="esperienza">
  <div class="exp-inner">
    <div class="eyebrow reveal">L'esperienza al tavolo</div>
    <h2 class="reveal">Quattro cose che ci rendono <em>diversi</em>.</h2>
    <div class="exp-grid reveal">
      <div class="exp-item reveal-child">
        <span class="num">— 01</span>
        <h3>Injera fatta in casa</h3>
        <p>Tre giorni di fermentazione naturale del teff. Niente farine industriali, nessuna scorciatoia. Ogni mattina ricominciamo daccapo.</p>
      </div>
      <div class="exp-item reveal-child">
        <span class="num">— 02</span>
        <h3>Berberè della casa</h3>
        <p>Dodici spezie tostate e macinate da noi. È la firma di ogni piatto e non si trova in nessun'altra cucina di Milano.</p>
      </div>
      <div class="exp-item reveal-child">
        <span class="num">— 03</span>
        <h3>Si condivide. Sempre.</h3>
        <p>Un unico grande piatto al centro del tavolo, e si mangia con le mani. La cucina è gesto, racconto, ricordo. Mai solo cibo.</p>
      </div>
      <div class="exp-item reveal-child">
        <span class="num">— 04</span>
        <h3>Caffè cerimonia</h3>
        <p>A fine pasto, su richiesta, la cerimonia del caffè etiope. Chicchi tostati al tavolo, incenso, tre tazze. Quaranta minuti di silenzio condiviso.</p>
      </div>
    </div>
  </div>
</section>

<!-- ===================== REVIEWS ===================== -->
<section class="reviews reveal">
  <div class="reviews-head">
    <div class="eyebrow reveal-child">Dicono di noi</div>
    <h2 class="reveal-child">Chi è stato qui, ci è tornato.</h2>
  </div>
  <div class="reviews-grid">
    <article class="review-card reveal-child">
      <div class="review-stars" aria-label="5 stars out of 5">★★★★★</div>
      <blockquote>What an amazing experience. Food is delicious, the staff is lovely and a very beautiful venue as well. One of the best and most authentic African meals I've had outside of Africa.</blockquote>
      <footer>
        <div class="reviewer">Lucio Ferrantini</div>
        <div class="platform">Google · Local Guide</div>
      </footer>
    </article>
    <article class="review-card reveal-child">
      <div class="review-stars" aria-label="5 stars out of 5">★★★★★</div>
      <blockquote>From the very first bite, I was transported straight back home. The flavors are deeply authentic, rich, and comforting — exactly like a home cooked meal prepared with love. An absolute must.</blockquote>
      <footer>
        <div class="reviewer">Esayas</div>
        <div class="platform">Google</div>
      </footer>
    </article>
    <article class="review-card reveal-child">
      <div class="review-stars" aria-label="5 stars out of 5">★★★★★</div>
      <blockquote>An incredible surprise. Spicy meat stew, lentil stew, cubed beef and other vegetables perfectly spiced on a dish meant to be shared. Zaid is welcoming and Giulia an absolute delight. An absolute gem.</blockquote>
      <footer>
        <div class="reviewer">Rachel Turner</div>
        <div class="platform">Google</div>
      </footer>
    </article>
    <article class="review-card reveal-child">
      <div class="review-stars" aria-label="5 stars out of 5">★★★★★</div>
      <blockquote>Excellent experience — food and service with kindness. If you're a local you'll be a regular, if you're a tourist it's a must try. Try the South African wine selection — you will not be disappointed.</blockquote>
      <footer>
        <div class="reviewer">Alan</div>
        <div class="platform">Google · Local Guide</div>
      </footer>
    </article>
    <article class="review-card reveal-child">
      <div class="review-stars" aria-label="10 su 10">★★★★★</div>
      <blockquote>Accoglienza ottima e atmosfera molto piacevole per arredi e musica. Ottima cucina etnica.</blockquote>
      <footer>
        <div class="reviewer">Silvia P.</div>
        <div class="platform">TheFork · 10/10</div>
      </footer>
    </article>
    <article class="review-card reveal-child">
      <div class="review-stars" aria-label="9.5 su 10">★★★★★</div>
      <blockquote>Personale infinitamente gentili e vi faranno scoppiare di cibo (soprattutto la mamma).</blockquote>
      <footer>
        <div class="reviewer">Joi C.</div>
        <div class="platform">TheFork · 9.5/10</div>
      </footer>
    </article>
  </div>
</section>

<!-- ===================== VISITA ===================== -->
<section class="visit" id="visita">
  <div class="visit-grid">
    <div class="visit-text reveal" id="prenota">
      <div class="eyebrow reveal-child">Visitaci</div>
      <h2 class="reveal-child">Ti aspettiamo a Porta Venezia.</h2>
      <p class="lead reveal-child">A due passi dalla metro, nel quartiere più cosmopolita di Milano. Prenota un tavolo per cena o passa per il pranzo — la sala è piccola, meglio avvisarci.</p>

      <ul class="visit-list reveal-child">
        <li>
          <div class="icon" aria-hidden="true">⌖</div>
          <div>
            <div class="label">Indirizzo</div>
            <div class="val">Via Panfilo Castaldi, 19</div>
            <div class="sub">20124 Milano — a 200 m da Porta Venezia</div>
          </div>
        </li>
        <li>
          <div class="icon" aria-hidden="true">⏱</div>
          <div>
            <div class="label">Orari</div>
            <div class="val">12:00–15:00 · 18:30–23:00</div>
            <div class="sub">Mar–Dom · Lunedì chiuso</div>
          </div>
        </li>
        <li>
          <div class="icon" aria-hidden="true">☎</div>
          <div>
            <div class="label">Prenotazioni</div>
            <div class="val"><a href="tel:+39022563527">02 2563527</a></div>
            <div class="sub"><a href="https://wa.me/393514313058" target="_blank" rel="noopener">Anche WhatsApp</a> · 351 431 3058</div>
          </div>
        </li>
      </ul>

      <div class="visit-cta reveal-child">
        <a href="https://www.thefork.it/ristorante/ristorante-al-sicomoro-r860688" class="btn" target="_blank" rel="noopener">Prenota su TheFork <span class="arrow" aria-hidden="true">→</span></a>
        <a href="tel:+39022563527" class="btn ghost">Chiama ora</a>
      </div>
    </div>

    <div class="map-card reveal">
      <iframe src="https://www.google.com/maps?q=Ristorante+Al+Sicomoro+Via+Panfilo+Castaldi+19+Milano&hl=it&z=16&output=embed" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Mappa del ristorante Al Sicomoro"></iframe>
      <div class="map-overlay">
        <div class="place">Al Sicomoro</div>
        <div class="addr">Via Panfilo Castaldi 19, Milano</div>
        <div class="metro">M1 · Porta Venezia · 3 min</div>
        <a href="https://www.google.com/maps/dir/?api=1&destination=Via+Panfilo+Castaldi+19+Milano" target="_blank" rel="noopener" class="directions">Apri indicazioni →</a>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/slider';
  import '../scripts/menu-filter';
</script>
</BaseLayout>
