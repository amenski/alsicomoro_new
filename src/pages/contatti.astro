---
import BaseLayout from '../layouts/BaseLayout.astro';

const breadcrumb = [{"name":"Home","item":"https://alsicomoro.com"},{"name":"Contatti","item":"https://alsicomoro.com/contatti.html"}];

---

<BaseLayout
  lang="it"
  page="contatti"
  title={"Contatti & Prenotazioni | Al Sicomoro – Porta Venezia, Milano"}
  description={"Prenota il tuo tavolo da Al Sicomoro. Via Panfilo Castaldi 19, Milano Porta Venezia. Tel: 02 2563527. Ristorante eritreo ed etiope a Milano."}
  ogDescription={"Prenota il tuo tavolo da Al Sicomoro. Via Panfilo Castaldi 19, Milano Porta Venezia. Tel: 02 2563527."}
  twitterTitle={"Contatti | Al Sicomoro"}
  twitterDescription={"Via Panfilo Castaldi 19, Milano. Tel: 02 2563527."}
  ogImage="/images/background.jpg"
  ogImageAlt={"Al Sicomoro restaurant atmosphere in Porta Venezia, Milan"}
  breadcrumb={breadcrumb}
>


<!-- ===================== CONTACT HERO ===================== -->
<section class="hero" style="min-height:40vh; max-height:460px; height:40vh; background:var(--terracotta)" aria-label="Contatti">
  <div class="hero-content" style="justify-content:center; padding-bottom:10px; align-items:center; text-align:center">
    <div class="eyebrow">Contatti</div>
    <h1 style="text-align:center; max-width:16ch">Contatti Al Sicomoro Milano</h1>
    <p class="lead" style="text-align:center">Siamo a Porta Venezia, nel cuore multiculturale di Milano. Chiamaci per prenotare o semplicemente per saperne di più.</p>
  </div>
</section>

<!-- ===================== CONTACT INFO ===================== -->
<section class="visit" id="contatti">
  <div class="visit-grid">
    <div class="visit-text reveal" style="max-width:600px; margin:0 auto">
      <div class="eyebrow reveal-child">Come raggiungerci</div>
      <h2 class="reveal-child">Ti aspettiamo a Porta Venezia.</h2>
      <p class="lead reveal-child">A due passi dalla metro, nel quartiere più cosmopolita di Milano. Prenota un tavolo per cena o passa per il pranzo.</p>

      <ul class="visit-list reveal-child">
        <li>
          <div class="icon" aria-hidden="true">⌖</div>
          <div>
            <div class="label">Indirizzo</div>
            <div class="val"><a href="https://maps.google.com/maps?q=Via+Panfilo+Castaldi+19,+20124+Milano" target="_blank" rel="noopener">Via Panfilo Castaldi, 19</a></div>
            <div class="sub">20124 Milano — a 200 m da Porta Venezia (M1)</div>
          </div>
        </li>
        <li>
          <div class="icon" aria-hidden="true">☎</div>
          <div>
            <div class="label">Telefono Fisso</div>
            <div class="val"><a href="tel:+39022563527">02 2563527</a></div>
            <div class="sub">Chiama per prenotare</div>
          </div>
        </li>
        <li>
          <div class="icon" aria-hidden="true">✆</div>
          <div>
            <div class="label">Mobile & WhatsApp</div>
            <div class="val"><a href="tel:+393514313058">351 431 3058</a></div>
            <div class="sub"><a href="https://wa.me/393514313058" target="_blank" rel="noopener" style="color:var(--terracotta); font-weight:600">Scrivici su WhatsApp →</a></div>
          </div>
        </li>
        <li>
          <div class="icon" aria-hidden="true">⏱</div>
          <div>
            <div class="label">Orari</div>
            <div class="val">12:00–15:00 · 18:30–23:00</div>
            <div class="sub">Martedì – Domenica · Lunedì: Chiuso</div>
          </div>
        </li>
      </ul>

      <div class="visit-cta reveal-child">
        <a href="https://www.thefork.it/ristorante/ristorante-al-sicomoro-r860688" class="btn" target="_blank" rel="noopener">Prenota su TheFork <span class="arrow" aria-hidden="true">→</span></a>
        <a href="tel:+39022563527" class="btn ghost">Chiama ora</a>
      </div>
    </div>

    <div class="map-card reveal">
      <iframe src="https://www.google.com/maps?q=Ristorante+Al+Sicomoro+Via+Panfilo+Castaldi+19+Milano&hl=it&z=16&output=embed" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Mappa del ristorante Al Sicomoro"></iframe>
      <div class="map-overlay">
        <div class="place">Al Sicomoro</div>
        <div class="addr">Via Panfilo Castaldi 19, Milano</div>
        <div class="metro">M1 · Porta Venezia · 3 min</div>
        <a href="https://www.google.com/maps/dir/?api=1&destination=Via+Panfilo+Castaldi+19+Milano" target="_blank" rel="noopener" class="directions">Apri indicazioni →</a>
      </div>
    </div>
  </div>
</section>

<!-- ===================== SOCIAL ===================== -->
<section class="reviews reveal">
  <div class="reviews-head">
    <div class="eyebrow reveal-child">Seguici</div>
    <h2 class="reveal-child">Resta connesso con noi.</h2>
    <p style="color:var(--charcoal-soft); margin-bottom:32px; max-width:40ch; margin-left:auto; margin-right:auto">Rimani aggiornato con le nostre ultime novità e scopri i piatti del giorno.</p>
    <div style="display:flex; justify-content:center; gap:20px; flex-wrap:wrap">
      <a href="https://www.instagram.com/al.sicomoro_" target="_blank" rel="noopener" class="btn" style="border-radius:50%; width:56px; height:56px; padding:0; justify-content:center" aria-label="Instagram">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5"/></svg>
      </a>
      <a href="https://www.tiktok.com/@al.sicomoro_" target="_blank" rel="noopener" class="btn ghost" style="border-radius:50%; width:56px; height:56px; padding:0; justify-content:center" aria-label="TikTok">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
      </a>
      <a href="https://wa.me/393514313058" target="_blank" rel="noopener" class="btn ghost" style="border-radius:50%; width:56px; height:56px; padding:0; justify-content:center; background:#25D366; color:white; border-color:#25D366" aria-label="WhatsApp">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
      </a>
    </div>
  </div>

  <div style="text-align:center; border-top:1px solid var(--line); padding-top:48px">
    <h2 class="reveal-child" style="max-width:none">Scopri di più su Al Sicomoro</h2>
    <p style="color:var(--charcoal-soft); margin-bottom:32px">Prima di venirci a trovare, esplora la nostra storia e i piatti che ti aspettano.</p>
    <div class="hero-cta" style="justify-content:center">
      <a href="/menu.html" class="btn">Scopri il Menu <span class="arrow" aria-hidden="true">→</span></a>
      <a href="/chi-siamo.html" class="btn ghost">La nostra storia</a>
    </div>
  </div>
</section>
</BaseLayout>
